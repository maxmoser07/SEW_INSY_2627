MERGE (n:Landmark {id: 'easter-island'}) SET n.name = 'Easter Island (Rapa Nui)', n.city = 'hanga-roa', n.lat = -27.113, n.lon = -109.35, n.kind = 'Archaeological site', n.description = 'Remote island famous for its 900 moai statues.';
MERGE (n:Landmark {id: 'galapagos-islands'}) SET n.name = 'Galápagos Islands', n.city = 'puerto-ayora', n.lat = -0.954, n.lon = -90.966, n.kind = 'Natural wonder', n.description = 'Volcanic archipelago that inspired Darwin\'s theory of evolution.';
MERGE (n:Landmark {id: 'salar-de-uyuni'}) SET n.name = 'Salar de Uyuni', n.city = 'sucre', n.lat = -20.134, n.lon = -67.489, n.kind = 'Natural wonder', n.description = '10,582 km² salt flat, the largest in the world.';
