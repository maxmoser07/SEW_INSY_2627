MERGE (n:Landmark {id: 'matterhorn'}) SET n.name = 'Matterhorn', n.city = 'geneva', n.lat = 45.976, n.lon = 7.659, n.kind = 'Mountain', n.description = '4,478 m pyramidal peak on the Swiss-Italian border.';
MERGE (n:Landmark {id: 'red-square'}) SET n.name = 'Red Square', n.city = 'moscow', n.lat = 55.754, n.lon = 37.621, n.kind = 'Square', n.description = 'Historic square between the Kremlin and Saint Basil\'s Cathedral.';
MERGE (n:Landmark {id: 'hagia-sophia'}) SET n.name = 'Hagia Sophia', n.city = 'istanbul', n.lat = 41.009, n.lon = 28.98, n.kind = 'Religious site', n.description = 'Byzantine cathedral turned mosque, completed in 537 AD.';
MERGE (n:Landmark {id: 'great-wall'}) SET n.name = 'Great Wall (Badaling)', n.city = 'beijing', n.lat = 40.36, n.lon = 116.02, n.kind = 'Wonder', n.description = 'Best-preserved section of China\'s 21,000 km fortification.';
MERGE (n:Landmark {id: 'forbidden-city'}) SET n.name = 'Forbidden City', n.city = 'beijing', n.lat = 39.916, n.lon = 116.397, n.kind = 'Palace', n.description = 'Imperial palace of the Ming and Qing dynasties.';
MERGE (n:Landmark {id: 'mount-fuji'}) SET n.name = 'Mount Fuji', n.city = 'tokyo', n.lat = 35.361, n.lon = 138.727, n.kind = 'Mountain', n.description = 'Japan\'s highest peak at 3,776 m.';
MERGE (n:Landmark {id: 'taj-mahal'}) SET n.name = 'Taj Mahal', n.city = 'new-delhi', n.lat = 27.175, n.lon = 78.042, n.kind = 'Wonder', n.description = 'White-marble mausoleum in Agra, completed in 1653.';
MERGE (n:Landmark {id: 'burj-khalifa'}) SET n.name = 'Burj Khalifa', n.city = 'dubai', n.lat = 25.197, n.lon = 55.274, n.kind = 'Monument', n.description = '828 m skyscraper, the tallest building in the world.';
MERGE (n:Landmark {id: 'marina-bay-sands'}) SET n.name = 'Marina Bay Sands', n.city = 'singapore', n.lat = 1.283, n.lon = 103.861, n.kind = 'Monument', n.description = 'Three-tower hotel with a 340 m rooftop sky park.';
MERGE (n:Landmark {id: 'mount-everest'}) SET n.name = 'Mount Everest', n.city = 'kathmandu', n.lat = 27.988, n.lon = 86.925, n.kind = 'Mountain', n.description = 'Earth\'s highest mountain above sea level at 8,849 m.';
MERGE (n:Landmark {id: 'borobudur'}) SET n.name = 'Borobudur', n.city = 'surabaya', n.lat = -7.608, n.lon = 110.204, n.kind = 'Religious site', n.description = 'Ninth-century Mahayana Buddhist temple in central Java.';
MERGE (n:Landmark {id: 'dead-sea'}) SET n.name = 'Dead Sea', n.city = 'jerusalem', n.lat = 31.559, n.lon = 35.473, n.kind = 'Natural wonder', n.description = 'Hypersaline lake at the lowest land elevation on Earth.';
MERGE (n:Landmark {id: 'pyramids-of-giza'}) SET n.name = 'Great Pyramid of Giza', n.city = 'cairo', n.lat = 29.979, n.lon = 31.134, n.kind = 'Wonder', n.description = 'Oldest of the Seven Wonders, built around 2560 BC.';
MERGE (n:Landmark {id: 'table-mountain'}) SET n.name = 'Table Mountain', n.city = 'cape-town', n.lat = -33.963, n.lon = 18.41, n.kind = 'Mountain', n.description = 'Flat-topped mountain overlooking Cape Town.';
MERGE (n:Landmark {id: 'cape-of-good-hope'}) SET n.name = 'Cape of Good Hope', n.city = 'cape-town', n.lat = -34.357, n.lon = 18.474, n.kind = 'Natural wonder', n.description = 'Rocky headland at the south-western tip of Africa.';
MERGE (n:Landmark {id: 'mount-kilimanjaro'}) SET n.name = 'Mount Kilimanjaro', n.city = 'arusha', n.lat = -3.067, n.lon = 37.356, n.kind = 'Mountain', n.description = 'Africa\'s highest peak at 5,895 m.';
MERGE (n:Landmark {id: 'statue-of-liberty'}) SET n.name = 'Statue of Liberty', n.city = 'new-york', n.lat = 40.689, n.lon = -74.045, n.kind = 'Monument', n.description = 'Copper statue gifted by France, dedicated in 1886.';
MERGE (n:Landmark {id: 'grand-canyon'}) SET n.name = 'Grand Canyon', n.city = 'las-vegas', n.lat = 36.107, n.lon = -112.113, n.kind = 'Natural wonder', n.description = '446 km-long canyon carved by the Colorado River.';
MERGE (n:Landmark {id: 'golden-gate-bridge'}) SET n.name = 'Golden Gate Bridge', n.city = 'san-francisco', n.lat = 37.82, n.lon = -122.478, n.kind = 'Bridge', n.description = '1.7 km suspension bridge spanning the Golden Gate strait.';
MERGE (n:Landmark {id: 'niagara-falls'}) SET n.name = 'Niagara Falls', n.city = 'toronto', n.lat = 43.096, n.lon = -79.038, n.kind = 'Natural wonder', n.description = 'Three waterfalls on the border of Canada and the United States.';
MERGE (n:Landmark {id: 'chichen-itza'}) SET n.name = 'Chichén Itzá', n.city = 'cancun', n.lat = 20.684, n.lon = -88.568, n.kind = 'Archaeological site', n.description = 'Maya city whose El Castillo pyramid dates to the 9th century.';
MERGE (n:Landmark {id: 'christ-the-redeemer'}) SET n.name = 'Christ the Redeemer', n.city = 'rio-de-janeiro', n.lat = -22.952, n.lon = -43.211, n.kind = 'Monument', n.description = '30 m Art Deco statue on Corcovado mountain.';
