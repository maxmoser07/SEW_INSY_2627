MERGE (n:Landmark {id: 'milford-sound'}) SET n.name = 'Milford Sound', n.city = 'queenstown', n.lat = -44.641, n.lon = 167.897, n.kind = 'Natural wonder', n.description = 'Fjord in Fiordland National Park with 1,000 m cliffs.';
MERGE (n:Landmark {id: 'great-barrier-reef'}) SET n.name = 'Great Barrier Reef', n.city = 'cairns', n.lat = -18.287, n.lon = 147.699, n.kind = 'Natural wonder', n.description = '2,300 km coral reef system, the largest living structure on Earth.';
MERGE (n:Landmark {id: 'south-pole'}) SET n.name = 'South Pole', n.city = 'south-pole-station', n.lat = -90, n.lon = 0, n.kind = 'Polar point', n.description = 'Southernmost point on Earth, site of the Amundsen-Scott station.';
